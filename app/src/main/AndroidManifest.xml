<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".CmhrApp"
        android:label="@string/cmhr_app_name"
        tools:replace="android:name,android:label">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TMessages"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Upstream launcher (LAUNCHER + LEANBACK_LAUNCHER); replaced by MainActivity above. -->
        <activity
            android:name="com.v2ray.ang.ui.main.MainActivity"
            tools:node="remove" />

        <!-- Upstream NotificationManager opens com.v2ray.ang.ui.main.MainActivity by class;
             this alias takes that component name and routes it to our MainActivity. -->
        <activity-alias
            android:name="com.v2ray.ang.ui.main.MainActivity"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- External entry points we do not offer: config import by URL scheme / share,
             Tasker plugin, home screen widget. Nodes only come from the managed subscription. -->
        <activity
            android:name="com.v2ray.ang.ui.UrlSchemeActivity"
            tools:node="remove" />
        <activity
            android:name="com.v2ray.ang.ui.shortcut.TaskerActivity"
            tools:node="remove" />
        <receiver
            android:name="com.v2ray.ang.receiver.TaskerReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.v2ray.ang.receiver.WidgetProvider"
            tools:node="remove" />
    </application>
</manifest>
