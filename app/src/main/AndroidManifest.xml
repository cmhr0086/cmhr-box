<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".CmhrApp"
        android:label="@string/cmhr_app_name"
        tools:replace="android:name,android:label">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TMessages"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Upstream launcher (LAUNCHER + LEANBACK_LAUNCHER); replaced by MainActivity above. -->
        <activity
            android:name="com.v2ray.ang.ui.main.MainActivity"
            tools:node="remove" />
    </application>
</manifest>
